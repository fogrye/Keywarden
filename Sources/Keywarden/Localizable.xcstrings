    "Values you generate or copy appear here until you log out or quit." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Waardes wat u genereer of kopieer, verskyn hier totdat u uitteken of die toep verlaat."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تظهر هنا القيم التي تولّدها أو تنسخها حتى تسجّل الخروج أو تُنهي التطبيق."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yaratdığınız və ya kopyaladığınız dəyərlər çıxış edənə və ya tətbiqi bağlayana qədər burada görünür."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Згенераваныя або скапіяваныя значэнні паказваюцца тут, пакуль вы не выйдзеце з уліковага запісу або не завершыце праграму."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Генерираните или копираните стойности се показват тук, докато не се отпишете или не затворите приложението."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hodnoty, které vygenerujete nebo zkopírujete, se tu zobrazují, dokud se neodhlásíte nebo aplikaci neukončíte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Werte, die du generierst oder kopierst, erscheinen hier, bis du dich abmeldest oder die App beendest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los valores que generes o copies aparecen aquí hasta que cierres sesión o salgas de la app."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Genereeritud või kopeeritud väärtused kuvatakse siin, kuni logid välja või sulged rakenduse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مقادیری که تولید یا کپی می‌کنید تا زمان خروج از حساب یا بستن برنامه اینجا نمایش داده می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Luomasi tai kopioimasi arvot näkyvät täällä, kunnes kirjaudut ulos tai lopetat sovelluksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
