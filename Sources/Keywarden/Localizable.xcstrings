    "Loads each login’s icon from your server’s icon service. Only the website’s domain is sent." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Laai elke aantekening se ikoon van u bediener se ikoondiens. Slegs die webwerf se domein word gestuur."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يحمّل أيقونة كل تسجيل دخول من خدمة الأيقونات على خادمك. يُرسل نطاق الموقع فقط."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hər girişin ikonunu serverinizin ikon xidmətindən yükləyir. Yalnız veb saytın domeni göndərilir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Загружае значок кожнага лагіна са службы значкоў вашага сервера. Адпраўляецца толькі дамен вэб-сайта."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зарежда иконата на всеки запис за вход от услугата за икони на сървъра ви. Изпраща се само домейнът на сайта."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Načítá ikony přihlašovacích údajů ze služby ikon vašeho serveru. Odesílá se jen doména webové stránky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lädt das Symbol jedes Zugangsdaten-Eintrags vom Symboldienst deines Servers. Nur die Domain der Website wird übertragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Carga el icono de cada entrada desde el servicio de iconos de tu servidor. Solo se envía el dominio de la web."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Laadib iga konto ikooni sinu serveri ikooniteenusest. Saadetakse ainult veebisaidi domeen."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نماد هر ورود را از سرویس نماد سرور شما بارگیری می‌کند. فقط دامنهٔ وب‌سایت ارسال می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lataa kunkin kirjautumistiedon kuvakkeen palvelimesi kuvakepalvelusta. Vain verkkosivuston verkkotunnus lähetetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Charge l’icône de chaque identifiant depuis le service d’icônes de votre serveur. Seul le domaine du site web est envoyé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपके सर्वर की आइकन सेवा से प्रत्येक लॉगिन का आइकन लोड करता है। केवल वेबसाइट का डोमेन भेजा जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Učitava ikonu svake prijave iz usluge ikona vašeg poslužitelja. Šalje se samo domena web stranice."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az egyes bejelentkezések ikonját a szerver ikonszolgáltatásából tölti be. Csak a webhely domainje kerül elküldésre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Memuat ikon setiap info masuk dari layanan ikon server Anda. Hanya domain situs web yang dikirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
