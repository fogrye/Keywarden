        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ будзе запытваць у гэтай праграмы разблакіроўку з Touch ID праз афіцыйнае пашырэнне Bitwarden."
          }
        },
        "bg" : {
          "stringUnit" : {
