        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SSH కీ మెటీరియల్‌ను ఇక్కడ మార్చలేరు. పేరు, ఫోల్డర్, గమనికలు మరియు అనుకూల ఫీల్డ్‌లను మార్చవచ్చు."
