    "Hide Keywarden when copying an item’s data, returning to the app you were using." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Versteek Keywarden wanneer u ’n item se data kopieer, en keer terug na die toep wat u gebruik het."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "إخفاء Keywarden عند نسخ بيانات عنصر، والعودة إلى التطبيق الذي كنت تستخدمه."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elementin məlumatı kopyalananda Keywarden gizlənir və istifadə etdiyiniz tətbiqə qayıdılır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Хаваць Keywarden пры капіяванні даных элемента і вяртацца ў праграму, з якой вы працавалі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скриване на Keywarden при копиране на данни от елемент и връщане към приложението, което сте използвали."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Při kopírování údajů položky skrýt Keywarden a vrátit se do aplikace, kterou jste používali."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
