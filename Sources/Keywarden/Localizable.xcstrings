    "Logging out removes the account from this Mac; signing back in needs your master password and a connection." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Om uit te teken verwyder die rekening van hierdie Mac. Om weer aan te teken, het u u hoofwagwoord en ’n verbinding nodig."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يؤدي تسجيل الخروج إلى إزالة الحساب من جهاز Mac هذا؛ ويتطلب تسجيل الدخول مجددًا كلمة المرور الرئيسية واتصالًا بالإنترنت."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Çıxış hesabı bu Mac-dən silir; yenidən daxil olmaq üçün ana parol və internet bağlantısı lazımdır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выхад выдаляе ўліковы запіс з гэтага Mac; для паўторнага ўваходу патрэбныя асноўны пароль і падключэнне да сеткі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Отписването премахва регистрацията от този Mac; за повторно вписване са нужни главната парола и връзка с интернет."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odhlášení odebere účet z tohoto Macu; k opětovnému přihlášení je potřeba hlavní heslo a připojení k internetu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beim Abmelden wird das Konto von diesem Mac entfernt. Zum erneuten Anmelden brauchst du dein Master-Passwort und eine Verbindung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al cerrar sesión, la cuenta se elimina de este Mac; para volver a iniciar sesión necesitarás tu contraseña maestra y conexión."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Väljalogimine eemaldab konto sellest Macist; uuesti sisselogimiseks on vaja ülemparooli ja võrguühendust."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "خروج، حساب را از این Mac حذف می‌کند؛ برای ورود دوباره به کلمه عبور اصلی و اتصال اینترنت نیاز است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uloskirjautuminen poistaa tilin tästä Macista. Uudelleen kirjautuminen vaatii pääsalasanan ja verkkoyhteyden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La déconnexion supprime le compte de ce Mac ; pour vous reconnecter, il vous faudra votre mot de passe principal et une connexion Internet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "लॉग आउट करने पर खाता इस Mac से हट जाता है; फिर से साइन इन करने के लिए आपके मास्टर पासवर्ड और इंटरनेट कनेक्शन की आवश्यकता होती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odjava uklanja račun s ovog Maca; za ponovnu prijavu potrebni su glavna lozinka i internetska veza."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A kijelentkezés eltávolítja a fiókot erről a Macről; az újbóli bejelentkezéshez a mesterjelszó és internetkapcsolat szükséges."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keluar akan menghapus akun dari Mac ini; untuk masuk kembali diperlukan kata sandi utama dan koneksi internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’uscita rimuove l’account da questo Mac; per accedere di nuovo servono la password principale e una connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ログアウトするとアカウントがこの Mac から削除されます。再度ログインするには、マスターパスワードとネットワーク接続が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "로그아웃하면 이 Mac에서 계정이 제거됩니다. 다시 로그인하려면 마스터 비밀번호와 네트워크 연결이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uitloggen verwijdert het account van deze Mac. Om weer in te loggen heb je je hoofdwachtwoord en een verbinding nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wylogowanie usuwa konto z tego Maca; ponowne zalogowanie wymaga hasła głównego i połączenia z internetem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Encerrar a sessão remove a conta deste Mac; para iniciar sessão de novo, são necessárias a senha principal e uma conexão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Terminar sessão remove a conta deste Mac; para voltar a iniciar sessão, precisa da palavra-passe mestra e de uma ligação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выход удаляет аккаунт с этого Mac; для повторного входа нужны мастер-пароль и подключение к сети."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odhlásenie odstráni účet z tohto Macu; na opätovné prihlásenie potrebujete hlavné heslo a pripojenie k internetu."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Одјављивање уклања налог са овог Mac-а; за поновну пријаву потребни су главна лозинка и веза са интернетом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "När du loggar ut tas kontot bort från den här Macen. För att logga in igen behöver du ditt huvudlösenord och en anslutning."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "வெளியேறினால் இந்த Mac-இலிருந்து கணக்கு அகற்றப்படும்; மீண்டும் உள்நுழைய முதன்மை கடவுச்சொல்லும் இணைய இணைப்பும் தேவை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "లాగ్ అవుట్ చేస్తే ఈ Mac నుండి ఖాతా తీసివేయబడుతుంది; మళ్లీ సైన్ ఇన్ చేయడానికి మీ మాస్టర్ పాస్‌వర్డ్ మరియు ఇంటర్నెట్ కనెక్షన్ అవసరం."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "การออกจากระบบจะลบบัญชีออกจาก Mac เครื่องนี้ การลงชื่อเข้าอีกครั้งต้องใช้รหัสผ่านหลักและการเชื่อมต่ออินเทอร์เน็ต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Çıkış yapmak hesabı bu Mac’ten kaldırır; yeniden giriş yapmak için ana parolanız ve bağlantı gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вихід вилучає обліковий запис із цього Mac; щоб знову увійти, потрібні головний пароль і з’єднання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Đăng xuất sẽ xóa tài khoản khỏi máy Mac này; để đăng nhập lại cần có mật khẩu chính và kết nối mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "注销会从这台 Mac 上移除该账户；重新登录需要主密码和网络连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "登出會從這台 Mac 移除該帳戶；重新登入需要主密碼和網路連線。"
          }
        }
      }
