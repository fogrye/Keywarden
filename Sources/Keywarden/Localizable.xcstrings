    "Archived items are kept out of your vault lists and autofill." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geargiveerde items word uit u kluislyste en outomatiese invul gehou."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُستبعد العناصر المؤرشفة من قوائم الخزنة ومن التعبئة التلقائية."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arxivlənmiş elementlər seyf siyahılarında göstərilmir və avtomatik doldurmada istifadə olunmur."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Архіўныя элементы не паказваюцца ў спісах сховішча і пры аўтазапаўненні."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Архивираните елементи не се показват в списъците на трезора и при автоматичното попълване."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Archivované položky se nezobrazují v seznamech trezoru ani při automatickém vyplňování."
