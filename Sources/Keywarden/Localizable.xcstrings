    "Confirm your master password to export. Only the individual vault is exported, not items shared through organizations or the trash." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bevestig u hoofwagwoord om uit te voer. Slegs die persoonlike kluis word uitgevoer, nie items wat deur organisasies gedeel word of die asblik nie."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أكّد كلمة المرور الرئيسية للتصدير. يتم تصدير الخزنة الفردية فقط، دون العناصر المشاركة عبر المؤسسات أو الموجودة في سلة المهملات."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İxrac etmək üçün ana parolunuzu təsdiqləyin. Yalnız şəxsi seyf ixrac olunur; təşkilatlar vasitəsilə paylaşılan elementlər və tullantı qutusu daxil edilmir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Каб экспартаваць, пацвердзіце асноўны пароль. Экспартуецца толькі асабістае сховішча, без элементаў, даступных праз арганізацыі, і без сметніцы."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Потвърдете главната парола, за да изнесете данните. Изнася се само личният трезор, без елементите, споделени чрез организации, и без кошчето."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Export potvrďte hlavním heslem. Exportuje se jen osobní trezor, ne položky sdílené přes organizace ani koš."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bestätige dein Master-Passwort, um zu exportieren. Nur der persönliche Tresor wird exportiert, nicht über Organisationen geteilte Einträge oder der Papierkorb."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Confirma tu contraseña maestra para exportar. Solo se exporta la caja fuerte individual, no los elementos compartidos a través de organizaciones ni la papelera."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eksportimiseks kinnita oma ülemparool. Eksporditakse ainult isiklik hoidla, mitte organisatsioonide kaudu jagatud üksusi ega prügikasti."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای برون‌ریزی، کلمه عبور اصلی خود را تأیید کنید. فقط گاوصندوق شخصی برون‌ریزی می‌شود، نه مواردی که از طریق سازمان‌ها به اشتراک گذاشته شده‌اند یا در سطل زباله هستند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vahvista vienti pääsalasanallasi. Vain henkilökohtainen holvi viedään, ei organisaatioiden kautta jaettuja kohteita eikä roskakoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Confirmez votre mot de passe principal pour exporter. Seul le coffre individuel est exporté, sans les éléments partagés via des organisations ni la corbeille."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "निर्यात करने के लिए अपने मास्टर पासवर्ड की पुष्टि करें। केवल व्यक्तिगत वॉल्ट निर्यात होता है, संगठनों के माध्यम से साझा किए गए आइटम या रीसायकल बिन के आइटम नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Za izvoz potvrdite glavnu lozinku. Izvozi se samo osobni trezor, bez stavki dijeljenih putem organizacija i bez smeća."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az exportáláshoz erősítse meg a mesterjelszót. Csak az egyéni széf kerül exportálásra, a szervezeteken keresztül megosztott elemek és a lomtár nem."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Konfirmasikan kata sandi utama Anda untuk mengekspor. Hanya brankas pribadi yang diekspor, tidak termasuk item yang dibagikan melalui organisasi atau item di sampah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conferma la password principale per esportare. Viene esportata solo la cassaforte personale, non gli elementi condivisi tramite organizzazioni né il cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "エクスポートするには、マスターパスワードを確認してください。エクスポートされるのは個人用保管庫のみで、組織で共有されているアイテムやごみ箱内のアイテムは含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "내보내려면 마스터 비밀번호를 확인하십시오. 개인 보관함만 내보내지며, 조직을 통해 공유된 항목이나 휴지통의 항목은 포함되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bevestig je hoofdwachtwoord om te exporteren. Alleen de persoonlijke kluis wordt geëxporteerd, niet de items die via organisaties worden gedeeld en niet de prullenbak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Potwierdź hasło główne, aby wyeksportować. Eksportowany jest tylko sejf osobisty, bez elementów udostępnionych przez organizacje i bez kosza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Confirme sua senha principal para exportar. Somente o cofre individual é exportado, sem os itens compartilhados por organizações nem a lixeira."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Confirme a palavra-passe mestra para exportar. Só é exportado o cofre individual, sem os itens partilhados através de organizações nem o lixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для экспорта подтвердите мастер-пароль. Экспортируется только личное хранилище, без элементов, доступных через организации, и без корзины."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Export potvrďte hlavným heslom. Exportuje sa iba osobný trezor, nie položky zdieľané cez organizácie ani kôš."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Потврдите главну лозинку за извоз. Извози се само лични сеф, без ставки дељених преко организација и без отпада."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bekräfta ditt huvudlösenord för att exportera. Endast det personliga valvet exporteras, inte objekt som delas via organisationer eller papperskorgen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ஏற்றுமதி செய்ய உங்கள் முதன்மை கடவுச்சொல்லை உறுதிசெய்யவும். தனிப்பட்ட வால்ட் மட்டுமே ஏற்றுமதி செய்யப்படும்; நிறுவனங்கள் மூலம் பகிரப்பட்ட உருப்படிகளும் குப்பையில் உள்ளவையும் சேர்க்கப்படாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ఎగుమతి చేయడానికి మీ మాస్టర్ పాస్‌వర్డ్‌ను నిర్ధారించండి. వ్యక్తిగత వాల్ట్ మాత్రమే ఎగుమతి అవుతుంది, సంస్థల ద్వారా షేర్ చేసిన అంశాలు లేదా ట్రాష్‌లోని అంశాలు కాదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ยืนยันรหัสผ่านหลักเพื่อส่งออก จะส่งออกเฉพาะตู้เซฟส่วนตัวเท่านั้น ไม่รวมรายการที่แชร์ผ่านองค์กรหรือรายการในถังขยะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dışa aktarmak için ana parolanızı onaylayın. Yalnızca kişisel kasa dışa aktarılır; kuruluşlar aracılığıyla paylaşılan kayıtlar ve çöp kutusu dahil edilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Підтвердіть головний пароль, щоб експортувати. Експортується лише особисте сховище, без записів, спільних через організації, і без смітника."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Xác nhận mật khẩu chính để xuất. Chỉ kho cá nhân được xuất, không bao gồm các mục được chia sẻ qua tổ chức hoặc trong thùng rác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "请确认主密码以导出。仅导出个人密码库，不包括通过组织共享的项目或回收站中的项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "請確認主密碼以匯出。僅會匯出個人密碼庫，不包括透過組織共享的項目或垃圾桶中的項目。"
          }
        }
      }
    },
