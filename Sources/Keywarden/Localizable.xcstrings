    "Asked for automatically when the vault is locked. Also required for browser unlock." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Word outomaties gevra wanneer die kluis vergrendel is. Ook nodig om in die blaaier te ontgrendel."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُطلب تلقائيًا عندما تكون الخزنة مقفلة. وهو مطلوب أيضًا لفتح القفل من المتصفح."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seyf kilidli olanda avtomatik soruşulur. Brauzerdə kilidi açmaq üçün də tələb olunur."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Запытваецца аўтаматычна, калі сховішча заблакіравана. Таксама патрэбна для разблакіроўкі ў браўзерах."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Изисква се автоматично, когато трезорът е заключен. Необходимо е и за отключване в браузърите."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyžádá se automaticky, když je trezor zamčený. Je také potřeba k odemykání v prohlížečích."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wird automatisch abgefragt, wenn der Tresor gesperrt ist. Auch zum Entsperren im Browser erforderlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se solicita automáticamente cuando la caja fuerte está bloqueada. También es necesario para desbloquear en el navegador."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Küsitakse automaatselt, kui hoidla on lukus. Vajalik ka brauserite lahtilukustamiseks."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وقتی گاوصندوق قفل است، به‌طور خودکار درخواست می‌شود. برای باز کردن قفل در مرورگر نیز لازم است."
          }
        },
        "fi" : {
          "stringUnit" : {
