    "Files are encrypted before they leave this Mac. The limit is 500 MB each." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lêers word geënkripteer voordat hulle hierdie Mac verlaat. Die limiet is 500 MB per lêer."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُشفَّر الملفات قبل أن تغادر جهاز Mac هذا. الحد الأقصى 500 ميجابايت لكل ملف."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fayllar bu Mac-dən çıxmazdan əvvəl şifrələnir. Hər fayl üçün limit 500 MB-dır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Файлы шыфруюцца яшчэ да адпраўкі з гэтага Mac. Памер кожнага — не больш за 500 МБ."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Файловете се шифрират, преди да напуснат този Mac. Ограничението е 500 МБ за файл."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Soubory se zašifrují dřív, než opustí tento Mac. Každý může mít nejvýše 500 MB."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dateien werden verschlüsselt, bevor sie diesen Mac verlassen. Pro Datei sind höchstens 500 MB erlaubt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los archivos se cifran antes de salir de este Mac. El límite es de 500 MB por archivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Failid krüpteeritakse enne, kui need sellest Macist lahkuvad. Iga faili suuruse piirang on 500 MB."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پرونده‌ها پیش از خروج از این Mac رمزگذاری می‌شوند. حداکثر حجم هر پرونده ۵۰۰ مگابایت است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tiedostot salataan ennen kuin ne lähtevät tästä Macista. Kunkin tiedoston enimmäiskoko on 500 Mt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les fichiers sont chiffrés avant de quitter ce Mac. La limite est de 500 Mo par fichier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "फ़ाइलें इस Mac से बाहर जाने से पहले एन्क्रिप्ट की जाती हैं। प्रत्येक फ़ाइल की सीमा 500 MB है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Datoteke se šifriraju prije nego što napuste ovaj Mac. Svaka može imati najviše 500 MB."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A fájlok titkosítva hagyják el ezt a Macet. Fájlonként legfeljebb 500 MB lehet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "File dienkripsi sebelum meninggalkan Mac ini. Batasnya 500 MB per file."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I file vengono crittografati prima di lasciare questo Mac. Il limite è di 500 MB per file."
