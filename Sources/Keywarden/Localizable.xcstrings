    "Touch ID changed since enrollment. Turn Touch ID off and on again in Settings." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID het sedert registrasie verander. Skakel Touch ID in Instellings af en weer aan."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تغيّر Touch ID منذ التسجيل. أوقف Touch ID ثم شغّله مجددًا في الإعدادات."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID qeydiyyatdan sonra dəyişib. Ayarlarda Touch ID-ni söndürüb yenidən aktivləşdirin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID змяніўся пасля налады. Выключыце і зноў уключыце Touch ID у Наладах."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID е променен след настройването. Изключете и отново включете Touch ID в Настройки."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID se od nastavení změnilo. Vypněte a znovu zapněte Touch ID v Nastavení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID wurde seit der Einrichtung geändert. Deaktiviere Touch ID in den Einstellungen und aktiviere es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID ha cambiado desde que se configuró. Desactiva y vuelve a activar Touch ID en Ajustes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID on pärast registreerimist muutunud. Lülita Touch ID seadetes välja ja uuesti sisse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID از زمان ثبت تغییر کرده است. Touch ID را در تنظیمات خاموش و دوباره روشن کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID on muuttunut rekisteröinnin jälkeen. Poista Touch ID käytöstä ja ota se uudelleen käyttöön asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID a changé depuis sa configuration. Désactivez puis réactivez Touch ID dans les réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नामांकन के बाद Touch ID बदल गया है। सेटिंग्ज़ में Touch ID को बंद करके फिर से चालू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID promijenio se od postavljanja. Isključite i ponovno uključite Touch ID u Postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Touch ID megváltozott a regisztráció óta. Kapcsolja ki, majd újra be a Touch ID-t a Beállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID telah berubah sejak didaftarkan. Matikan lalu nyalakan lagi Touch ID di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID è cambiato dalla configurazione. Disattiva e riattiva Touch ID nelle impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "登録後に Touch ID が変更されました。設定で Touch ID をいったんオフにしてから、もう一度オンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "등록 이후 Touch ID가 변경되었습니다. 설정에서 Touch ID를 껐다가 다시 켜십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID is gewijzigd sinds de registratie. Schakel Touch ID in Instellingen uit en weer in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID zmieniło się od konfiguracji. Wyłącz i ponownie włącz Touch ID w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Touch ID mudou desde o cadastro. Desative e ative o Touch ID novamente nos Ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Touch ID mudou desde o registo. Desative e volte a ativar o Touch ID nas Definições."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID изменился после настройки. Выключите и снова включите Touch ID в Настройках."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID sa od nastavenia zmenilo. Vypnite a znova zapnite Touch ID v Nastaveniach."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID се променио од регистрације. Искључите па поново укључите Touch ID у подешавањима."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID har ändrats sedan registreringen. Stäng av och slå på Touch ID igen i Inställningar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "பதிவுசெய்த பிறகு Touch ID மாறியுள்ளது. அமைப்புகளில் Touch ID-ஐ அணைத்து மீண்டும் இயக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "నమోదు తర్వాత Touch ID మారింది. సెట్టింగ్‌లలో Touch IDని ఆఫ్ చేసి మళ్లీ ఆన్ చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID มีการเปลี่ยนแปลงตั้งแต่ลงทะเบียน ให้ปิดแล้วเปิด Touch ID อีกครั้งในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID, kayıttan sonra değişti. Ayarlar’da Touch ID’yi kapatıp yeniden açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID змінено після налаштування. Вимкніть і знову ввімкніть Touch ID у Параметрах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID đã thay đổi kể từ khi đăng ký. Hãy tắt rồi bật lại Touch ID trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID 在注册后发生了变化。请在设置中关闭 Touch ID，然后重新打开。"
