        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hodnoty, ktoré vygenerujete alebo skopírujete, sa tu zobrazujú, kým sa neodhlásite alebo aplikáciu neukončíte."
          }
        },
        "sr" : {
          "stringUnit" : {
