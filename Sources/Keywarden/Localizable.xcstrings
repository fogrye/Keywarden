          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपके द्वारा जनरेट या कॉपी किए गए मान लॉग आउट करने या ऐप बंद करने तक यहाँ दिखाई देते हैं।"
