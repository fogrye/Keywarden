    "SSH key material can’t be changed here. Name, folder, notes and custom fields can." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SSH-sleutelmateriaal kan nie hier verander word nie. Naam, vouer, notas en pasgemaakte velde wel."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يمكن تغيير بيانات مفتاح SSH هنا. يمكن تغيير الاسم والمجلد والملاحظات والحقول المخصصة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SSH açarının məzmunu burada dəyişdirilə bilməz. Ad, qovluq, notlar və özəl xanalar dəyişdirilə bilər."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сам ключ SSH тут змяніць нельга. Назву, папку, нататкі і карыстальніцкія палі — можна."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Самият SSH ключ не може да бъде променян тук. Името, папката, бележките и допълнителните полета могат."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Samotný SSH klíč zde změnit nelze. Název, složku, poznámky a vlastní pole ano."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das SSH-Schlüsselmaterial kann hier nicht geändert werden. Name, Ordner, Notizen und benutzerdefinierte Felder schon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los datos de la clave SSH no se pueden cambiar aquí. El nombre, la carpeta, las notas y los campos personalizados sí."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SSH võtit ei saa siin muuta. Nime, kausta, märkmeid ja kohandatud välju saab."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "محتوای کلید SSH را اینجا نمی‌توان تغییر داد. نام، پوشه، یادداشت‌ها و فیلدهای سفارشی قابل تغییرند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SSH-avainta ei voi muuttaa täällä. Nimeä, kansiota, merkintöjä ja lisäkenttiä voi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les données de la clé SSH ne peuvent pas être modifiées ici. Le nom, le dossier, les notes et les champs personnalisés peuvent l’être."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SSH कुंजी सामग्री यहाँ नहीं बदली जा सकती। नाम, फ़ोल्डर, नोट्स और कस्टम फ़ील्ड बदले जा सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sam SSH ključ ovdje nije moguće promijeniti. Naziv, mapu, bilješke i prilagođena polja jest."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az SSH kulcs itt nem módosítható. A név, a mappa, a jegyzetek és az egyedi mezők igen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Materi kunci SSH tidak dapat diubah di sini. Nama, folder, catatan, dan bidang khusus dapat diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I dati della chiave SSH non possono essere modificati qui. Nome, cartella, note e campi personalizzati sì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SSH 鍵の内容はここでは変更できません。名前、フォルダー、メモ、カスタムフィールドは変更できます。"
