    "Unlocks this Mac without your master password. Five wrong PINs turn it off." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ontgrendel op hierdie Mac sonder u hoofwagwoord. Vyf verkeerde PIN’s skakel dit af."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يفتح القفل على جهاز Mac هذا دون كلمة المرور الرئيسية. يتوقف بعد إدخال رمز PIN خاطئ خمس مرات."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu Mac-də Keywarden-in kilidini ana parol olmadan açır. Beş dəfə yanlış PIN daxil edilsə, söndürülür."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Разблакіруе Keywarden на гэтым Mac без асноўнага пароля. Пасля пяці няправільных спроб PIN-код адключаецца."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Отключва Keywarden на този Mac без главната парола. След пет грешни опита ПИН кодът се изключва."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odemyká na tomto Macu bez hlavního hesla. Po pěti chybně zadaných PINech se vypne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entsperrt auf diesem Mac ohne dein Master-Passwort. Nach fünf falschen PINs wird die Option deaktiviert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desbloquea la caja fuerte en este Mac sin tu contraseña maestra. Cinco PIN incorrectos desactivan la opción."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lukustab hoidla selles Macis lahti ilma ülemparoolita. Viis valet PIN-i lülitab selle välja."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قفل را روی این Mac بدون کلمه عبور اصلی باز می‌کند. پنج بار وارد کردن کد پین اشتباه، آن را خاموش می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avaa holvin tässä Macissa ilman pääsalasanaa. Viisi väärää PIN-koodia poistaa sen käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Déverrouille le coffre sur ce Mac sans votre mot de passe principal. Cinq codes PIN erronés désactivent cette option."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "मास्टर पासवर्ड के बिना इस Mac पर अनलॉक करता है। पाँच बार गलत PIN डालने पर यह बंद हो जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otključava na ovom Macu bez glavne lozinke. Nakon pet pogrešnih PIN-ova isključuje se."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mesterjelszó nélkül oldja fel a széfet ezen a Macen. Öt hibás pinkód után kikapcsol."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Membuka kunci di Mac ini tanpa kata sandi utama. Lima kali salah memasukkan PIN akan mematikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sblocca la cassaforte su questo Mac senza la password principale. Cinque PIN errati disattivano l’opzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この Mac でマスターパスワードなしでロックを解除できます。PIN を 5 回間違えるとオフになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 Mac에서 마스터 비밀번호 없이 잠금 해제합니다. PIN을 5번 잘못 입력하면 꺼집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ontgrendelt op deze Mac zonder je hoofdwachtwoord. Na vijf verkeerde pincodes wordt dit uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odblokowuje na tym Macu bez hasła głównego. Po pięciu błędnych kodach PIN ta opcja zostanie wyłączona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desbloqueia o Keywarden neste Mac sem a senha principal. Cinco PINs incorretos desativam esta opção."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desbloqueia o Keywarden neste Mac sem a palavra-passe mestra. Cinco PIN errados desativam esta opção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Разблокирует Keywarden на этом Mac без мастер-пароля. После пяти неверных попыток PIN-код отключается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odomyká na tomto Macu bez hlavného hesla. Po piatich nesprávnych PIN kódoch sa vypne."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Откључава сеф на овом Mac-у без главне лозинке. Пет погрешних ПИН-ова га искључује."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Låser upp på den här Macen utan ditt huvudlösenord. Efter fem felaktiga PIN-koder stängs det av."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "முதன்மை கடவுச்சொல் இல்லாமல் இந்த Mac-இல் திறக்கும். ஐந்து முறை தவறான PIN உள்ளிட்டால் இது முடக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "మీ మాస్టర్ పాస్‌వర్డ్ లేకుండా ఈ Macలో అన్‌లాక్ చేస్తుంది. ఐదుసార్లు తప్పు PIN నమోదు చేస్తే ఇది ఆఫ్ అవుతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ปลดล็อกบน Mac เครื่องนี้โดยไม่ต้องใช้รหัสผ่านหลัก หากป้อน PIN ผิดห้าครั้ง ตัวเลือกนี้จะถูกปิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keywarden uygulamasının kilidini bu Mac’te ana parolanız olmadan açar. Beş kez yanlış PIN girilirse kapanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Розблоковує Keywarden на цьому Mac без головного пароля. Після п’яти хибних спроб PIN-код вимикається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mở khóa trên máy Mac này mà không cần mật khẩu chính. Nhập sai mã PIN năm lần sẽ tắt tính năng này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "无需主密码即可在这台 Mac 上解锁。PIN 码输错五次后，此功能将关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "不需主密碼即可在這台 Mac 上解鎖。PIN 碼輸入錯誤五次後，此功能會關閉。"
          }
        }
      }
    },
