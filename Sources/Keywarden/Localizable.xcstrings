    "Locking keeps your account signed in; unlock with your master password, PIN or Touch ID." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Met vergrendel bly u rekening aangeteken. Ontgrendel met u hoofwagwoord, PIN of Touch ID."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُبقي القفل حسابك مسجّل الدخول؛ افتح القفل بكلمة المرور الرئيسية أو رمز PIN أو Touch ID."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kilidləmə hesabınızda seansı açıq saxlayır; kilidi ana parol, PIN və ya Touch ID ilə açın."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Пры блакіроўцы ўваход ва ўліковы запіс захоўваецца; разблакіруйце асноўным паролем, PIN-кодам або Touch ID."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "При заключване оставате вписани в регистрацията си; отключвайте с главната парола, ПИН или Touch ID."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Při zamknutí zůstanete přihlášeni; odemknete hlavním heslem, PINem nebo pomocí Touch ID."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beim Sperren bleibt dein Konto angemeldet. Entsperre mit deinem Master-Passwort, deiner PIN oder Touch ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al bloquear, tu sesión sigue iniciada; desbloquea con tu contraseña maestra, el PIN o Touch ID."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lukustamisel jääb konto sisselogituks; lukusta lahti ülemparooli, PIN-i või Touch ID-ga."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "با قفل کردن، حساب شما همچنان وارد می‌ماند؛ قفل را با کلمه عبور اصلی، کد پین یا Touch ID باز کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lukittaessa tili pysyy kirjautuneena. Avaa pääsalasanalla, PIN-koodilla tai Touch ID:llä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le verrouillage garde votre compte connecté ; déverrouillez avec votre mot de passe principal, votre code PIN ou Touch ID."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "लॉक करने पर आपका खाता साइन इन रहता है; अपने मास्टर पासवर्ड, PIN या Touch ID से अनलॉक करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zaključavanjem ostajete prijavljeni; otključajte glavnom lozinkom, PIN-om ili Touch ID-jem."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lezáráskor a fiók bejelentkezve marad; feloldás mesterjelszóval, pinkóddal vagy Touch ID-val."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mengunci membuat akun Anda tetap masuk; buka kunci dengan kata sandi utama, PIN, atau Touch ID."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il blocco mantiene l’accesso all’account; sblocca con la password principale, il PIN o Touch ID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ロックしてもアカウントはログインしたままです。マスターパスワード、PIN、または Touch ID でロックを解除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "잠가도 계정은 로그인 상태로 유지됩니다. 마스터 비밀번호, PIN 또는 Touch ID로 잠금 해제할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bij vergrendelen blijf je ingelogd. Ontgrendel met je hoofdwachtwoord, pincode of Touch ID."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po zablokowaniu pozostajesz zalogowany; odblokuj hasłem głównym, kodem PIN lub przez Touch ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O bloqueio mantém sua sessão iniciada; desbloqueie com a senha principal, o PIN ou o Touch ID."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bloquear mantém a sessão da conta iniciada; desbloqueie com a palavra-passe mestra, o PIN ou o Touch ID."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "При блокировке вход в аккаунт сохраняется; разблокируйте мастер-паролем, PIN-кодом или Touch ID."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po zamknutí zostanete prihlásení; odomknete hlavným heslom, PIN kódom alebo pomocou Touch ID."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Закључавањем налог остаје пријављен; откључајте главном лозинком, ПИН-ом или Touch ID-ом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "När valvet låses förblir du inloggad. Lås upp med huvudlösenordet, PIN-koden eller Touch ID."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "பூட்டினால் உங்கள் கணக்கு உள்நுழைந்த நிலையிலேயே இருக்கும்; முதன்மை கடவுச்சொல், PIN அல்லது Touch ID மூலம் திறக்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "లాక్ చేసినా మీ ఖాతా సైన్ ఇన్ అయి ఉంటుంది; మీ మాస్టర్ పాస్‌వర్డ్, PIN లేదా Touch IDతో అన్‌లాక్ చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "การล็อกจะยังคงให้บัญชีของคุณลงชื่อเข้าอยู่ ปลดล็อกได้ด้วยรหัสผ่านหลัก, PIN หรือ Touch ID"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kilitlemek hesabınızın oturumunu açık tutar; kilidi ana parolanız, PIN veya Touch ID ile açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Після блокування ви залишаєтеся в обліковому записі; розблоковуйте головним паролем, PIN-кодом або Touch ID."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Khóa sẽ giữ tài khoản của bạn ở trạng thái đăng nhập; mở khóa bằng mật khẩu chính, mã PIN hoặc Touch ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "锁定后账户仍保持登录；可使用主密码、PIN 码或 Touch ID 解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "鎖定後帳戶仍保持登入；可使用主密碼、PIN 碼或 Touch ID 解鎖。"
          }
        }
      }
    },
