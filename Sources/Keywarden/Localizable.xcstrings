    "!@#$%^&*" : {
      "shouldTranslate" : false
    },
    "%@ already has a Bitwarden connection. Replace it to take over." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ het reeds ’n Bitwarden-verbinding. Vervang dit om oor te neem."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لدى %@ اتصال بـ Bitwarden بالفعل. استبدله ليتولاه هذا التطبيق."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ brauzerində artıq Bitwarden bağlantısı var. Onu öz üzərinizə götürmək üçün bağlantını əvəz edin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "У %@ ужо ёсць падключэнне да Bitwarden. Замяніце яго, каб падключыць гэту праграму."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ вече има връзка с Bitwarden. Заменете я, за да свържете това приложение."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ už má připojení k Bitwardenu. Chcete-li ho převzít, nahraďte ho."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hat bereits eine Bitwarden-Verbindung. Ersetze sie, um sie zu übernehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ya tiene una conexión de Bitwarden. Sustitúyela para tomar el control."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brauseril %@ on juba Bitwardeni ühendus. Ülevõtmiseks asenda see."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ از قبل اتصال Bitwarden دارد. برای در دست گرفتن آن، جایگزینش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Selaimella %@ on jo Bitwarden-yhteys. Korvaa se, niin tämä sovellus ottaa yhteyden hoitaakseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ a déjà une connexion Bitwarden. Remplacez-la pour la reprendre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ में पहले से एक Bitwarden कनेक्शन है। इस ऐप को कनेक्शन सौंपने के लिए उसे बदलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ već ima vezu s Bitwardenom. Zamijenite je da biste je preuzeli."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A(z) %@ már rendelkezik Bitwarden-kapcsolattal. Az átvételhez cserélje le."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ sudah memiliki koneksi Bitwarden. Ganti koneksi tersebut untuk mengambil alih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ha già una connessione Bitwarden. Sostituiscila per subentrare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ にはすでに Bitwarden の接続があります。引き継ぐには置き換えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@에 이미 Bitwarden 연결이 있습니다. 이 앱이 대신 사용하려면 연결을 대치하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ heeft al een Bitwarden-verbinding. Vervang deze om hem over te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przeglądarka %@ ma już połączenie z Bitwardenem. Zastąp je, aby je przejąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O %@ já tem uma conexão do Bitwarden. Substitua-a para assumir o controle."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O %@ já tem uma ligação do Bitwarden. Substitua-a para assumir o controlo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "У %@ уже есть подключение к Bitwarden. Замените его, чтобы подключить это приложение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ už má pripojenie k Bitwardenu. Ak ho chcete prevziať, nahraďte ho."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ већ има Bitwarden везу. Замените је да бисте је преузели."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ har redan en Bitwarden-anslutning. Ersätt den för att ta över."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-இல் ஏற்கெனவே ஒரு Bitwarden இணைப்பு உள்ளது. அதை இந்தச் செயலிக்கு மாற்ற, இணைப்பை மாற்றவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@కి ఇప్పటికే Bitwarden కనెక్షన్ ఉంది. దాన్ని ఈ యాప్‌కు మార్చడానికి భర్తీ చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ มีการเชื่อมต่อ Bitwarden อยู่แล้ว ให้แทนที่การเชื่อมต่อนั้นเพื่อเข้าควบคุมแทน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ tarayıcısında zaten bir Bitwarden bağlantısı var. Devralmak için bu bağlantıyı değiştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ уже має з’єднання з Bitwarden. Замініть його, щоб під’єднати цю програму."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ đã có kết nối Bitwarden. Hãy thay thế kết nối đó để tiếp quản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 已有 Bitwarden 连接。替换该连接即可接管。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 已有 Bitwarden 連線。取代該連線即可接管。"
          }
        }
      }
    },
