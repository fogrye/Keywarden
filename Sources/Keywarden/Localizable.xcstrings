    "%@ is registered with %@. That registration is saved and restored if you disconnect." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ is geregistreer met %2$@. Daardie registrasie word bewaar en teruggestel as u die verbinding verbreek."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تم تسجيل %1$@ في %2$@. يتم حفظ هذا التسجيل واستعادته إذا قطعت الاتصال."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ brauzeri bu qeydiyyatla qoşulub: %2$@. Bu qeydiyyat saxlanılır və bağlantını kəssəniz bərpa olunur."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "У %1$@ зарэгістравана праграма %2$@. Гэта рэгістрацыя захавана і будзе адноўлена, калі вы адключыце браўзер."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ е регистриран чрез %2$@. Тази регистрация е запазена и ще бъде възстановена, ако прекъснете връзката."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ je zaregistrován v %2$@. Tato registrace se uloží a po odpojení obnoví."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ ist bei %2$@ registriert. Diese Registrierung wird gesichert und wiederhergestellt, wenn du die Verbindung trennst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is registered with %2$@. That registration is saved and restored if you disconnect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ está registrado con %2$@. Ese registro se guarda y se restaura si desconectas el navegador."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brauser %1$@ on registreeritud asukohaga %2$@. See registreering salvestatakse ja taastatakse, kui ühenduse katkestad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ در %2$@ ثبت شده است. این ثبت ذخیره می‌شود و اگر اتصال را قطع کنید، بازگردانده می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Selaimen %1$@ rekisteröinti: %2$@. Rekisteröinti tallennetaan ja palautetaan, jos katkaiset yhteyden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ est enregistré avec %2$@. Cet enregistrement est conservé et restauré si vous déconnectez le navigateur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
