        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "நீங்கள் உருவாக்கும் அல்லது நகலெடுக்கும் மதிப்புகள், நீங்கள் வெளியேறும் வரை அல்லது செயலியை மூடும் வரை இங்கே தோன்றும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "మీరు రూపొందించే లేదా కాపీ చేసే విలువలు మీరు లాగ్ అవుట్ చేసే వరకు లేదా నిష్క్రమించే వరకు ఇక్కడ కనిపిస్తాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ค่าที่คุณสร้างหรือคัดลอกจะแสดงที่นี่จนกว่าคุณจะออกจากระบบหรือออกจากแอป"
